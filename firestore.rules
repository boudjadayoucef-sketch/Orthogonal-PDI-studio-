rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default allow for application operational collections
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicit collection access
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /projects/{projectId} {
      allow read, write: if true;

      match /isometrics/{isoId} {
        allow read, write: if true;
      }
    }

    match /payment_transactions/{txId} {
      allow read, write: if true;
    }

    match /connection_logs/{logId} {
      allow read, write: if true;
    }

    match /commercial_visits/{visitId} {
      allow read, write: if true;
    }

    match /user_feedbacks/{feedId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedId} {
      allow read, write: if true;
    }

    match /license_keys/{keyId} {
      allow read, write: if true;
    }

    match /subscriber_usage/{usageId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /auth_credentials/{credId} {
      allow read, write: if true;
    }

    match /auth_connections/{logId} {
      allow read, write: if true;
    }

    match /subscribers/{subId} {
      allow read, write: if true;
    }

    match /pdi_subscribers/{subId} {
      allow read, write: if true;
    }
  }
}

