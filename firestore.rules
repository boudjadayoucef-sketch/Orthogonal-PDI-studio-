rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.email == "Boudjada.youcef@gmail.com"
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "Boudjada.youcef@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection des Utilisateurs (/users/{userId})
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'tenantId', 'role'])
          && data.email is string && data.email.size() > 0 && data.email.size() <= 256
          && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128
          && data.role is string && (data.role == "admin" || data.role == "engineer" || data.role == "viewer");
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.tenantId == getUserTenantId() || isAdmin());
      allow create: if isEmailVerified() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isEmailVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin())
        && isValidUser(incoming())
        && incoming().tenantId == existing().tenantId;
      allow delete: if isAdmin();
    }

    // Collection des Projets (/projects/{projectId})
    match /projects/{projectId} {
      function isValidProject(data) {
        return data.keys().hasAll(['name', 'code', 'tenantId', 'ownerId'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 128
          && data.code is string && data.code.size() > 0 && data.code.size() <= 64
          && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128
          && data.ownerId is string && data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isValidId(projectId) && (resource.data.tenantId == getUserTenantId() || isAdmin());
      allow list: if isSignedIn() && (resource.data.tenantId == getUserTenantId() || isAdmin());
      allow create: if isEmailVerified() && isValidId(projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().tenantId == getUserTenantId()
        && isValidProject(incoming());
      allow update: if isEmailVerified() && isValidId(projectId)
        && (resource.data.tenantId == getUserTenantId() || isAdmin())
        && isValidProject(incoming())
        && incoming().tenantId == existing().tenantId
        && incoming().ownerId == existing().ownerId;
      allow delete: if isEmailVerified() && isValidId(projectId)
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      // Sous-collection des Isométries (/projects/{projectId}/isometrics/{isoId})
      match /isometrics/{isoId} {
        function isValidIsometric(data) {
          return data.keys().hasAll(['title', 'projectId', 'tenantId', 'ownerId'])
            && data.title is string && data.title.size() > 0 && data.title.size() <= 128
            && data.projectId is string && data.projectId == projectId
            && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128
            && data.ownerId is string && data.ownerId == request.auth.uid;
        }

        function getParentProject() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }

        allow get: if isSignedIn() && isValidId(isoId)
          && (getParentProject().tenantId == getUserTenantId() || isAdmin());
        allow list: if isSignedIn()
          && (getParentProject().tenantId == getUserTenantId() || isAdmin());
        allow create: if isEmailVerified() && isValidId(isoId)
          && getParentProject().tenantId == getUserTenantId()
          && incoming().projectId == projectId
          && incoming().tenantId == getUserTenantId()
          && incoming().ownerId == request.auth.uid
          && isValidIsometric(incoming());
        allow update: if isEmailVerified() && isValidId(isoId)
          && (getParentProject().tenantId == getUserTenantId() || isAdmin())
          && isValidIsometric(incoming())
          && incoming().tenantId == existing().tenantId
          && incoming().ownerId == existing().ownerId;
        allow delete: if isEmailVerified() && isValidId(isoId)
          && (resource.data.ownerId == request.auth.uid || isAdmin());
      }
    }
  }
}
