{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur avec rôles, abonnements, localisation et état du compte.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "city": { "type": "string" },
        "paymentGateway": { "type": "string" },
        "currency": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "client", "guest", "demo"] },
        "accountType": { "type": "string", "enum": ["basic", "pro", "enterprise", "team"] },
        "subscriptionPlan": { "type": "string", "enum": ["monthly", "yearly", "trial", "lifetime"] },
        "status": { "type": "string", "enum": ["active", "suspended", "pending_activation"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "loginCount": { "type": "number" },
        "projectsCount": { "type": "number" },
        "storageUsedKb": { "type": "number" }
      },
      "required": ["uid", "email", "role", "accountType", "subscriptionPlan", "status"]
    },
    "paymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Transactions de souscription SaaS, routées selon le pays (Slick-Pay BaridiMob pour Algérie, Paddle pour international).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "city": { "type": "string" },
        "plan": { "type": "string" },
        "billingCycle": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "provider": { "type": "string", "enum": ["slickpay_baridimob", "paddle"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userEmail", "plan", "amount", "currency", "provider", "status", "createdAt"]
    },
    "connectionLog": {
      "title": "ConnectionLog",
      "description": "Journal d'authentification et d'accès des abonnés.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "accountType": { "type": "string" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["success", "failed"] }
      },
      "required": ["id", "userId", "userEmail", "timestamp"]
    },
    "commercialVisit": {
      "title": "CommercialVisit",
      "description": "Suivi des visites du site vitrine commercial et intérêt des visiteurs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "referrer": { "type": "string" },
        "section": { "type": "string" },
        "action": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "path", "timestamp"]
    },
    "userFeedback": {
      "title": "UserFeedback",
      "description": "Retours d'expérience utilisateurs, avis, notations et suggestions techniques.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "category": { "type": "string", "enum": ["feature_request", "bug_report", "general_feedback", "satisfaction"] },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "reviewed", "in_progress", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "adminNotes": { "type": "string" }
      },
      "required": ["id", "userEmail", "category", "rating", "message", "createdAt"]
    },
    "subscriberUsage": {
      "title": "SubscriberUsage",
      "description": "Suivi de l'activité réelle et de l'usage fonctionnel par les abonnés.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "action", "module", "timestamp"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "userProfile",
      "description": "Collection des profils utilisateurs et abonnements."
    },
    "/connection_logs/{logId}": {
      "schema": "connectionLog",
      "description": "Historique des connexions et tentatives d'accès."
    },
    "/commercial_visits/{visitId}": {
      "schema": "commercialVisit",
      "description": "Trafic et télémétrie du site commercial."
    },
    "/user_feedbacks/{feedbackId}": {
      "schema": "userFeedback",
      "description": "Retours d'expérience et avis clients."
    },
    "/subscriber_usage/{usageId}": {
      "schema": "subscriberUsage",
      "description": "Journal d'utilisation par les abonnés."
    },
    "/payment_transactions/{transactionId}": {
      "schema": "paymentTransaction",
      "description": "Transactions de paiements et souscriptions des abonnés."
    },
    "/system_config/{configId}": {
      "description": "Configuration globale du système (restrictions pays, clés passerelles de paiement)."
    }
  }
}
