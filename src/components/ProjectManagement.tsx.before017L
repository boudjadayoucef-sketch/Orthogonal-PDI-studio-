  const formatDateFrench = (dateStr?: string) => {
    if (!dateStr || dateStr.trim() === "") return "Non renseign√©e";
    try {
      const parts = dateStr.split("-");
      if (parts.length === 3) {
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      }
      return dateStr;
    } catch (e) {
      return dateStr;
    }
  };

  const getGenesisMilestones = (p: any) => {
    const milestones = [];
    if (!p) return [];

    // 1. Cr√©ation de l'affaire
    let creationDate = "Non renseign√©e";
    if (p.createdAt) {
      if (typeof p.createdAt === "string") {
        creationDate = p.createdAt.substring(0, 10);
      } else if (p.createdAt.toDate) {
        creationDate = p.createdAt.toDate().toISOString().substring(0, 10);
      } else if (p.createdAt.seconds) {
        creationDate = new Date(p.createdAt.seconds * 1000).toISOString().substring(0, 10);
      }
    } else if (p.planning?.etudeStart) {
      creationDate = p.planning.etudeStart;
    }
    
    milestones.push({
      key: "creation",
      title: "Cr√©ation de l'Affaire",
      date: creationDate,
      status: "completed",
      color: "bg-blue-500",
      description: "Enregistrement officiel de l'ouvrage gazoduc dans le portefeuille d'investissement de Sonelgaz.",
      details: [
        { label: "Nom de l'affaire", value: p.name },
        { label: "Cadre d'inscription", value: p.identity?.cadreInscription },
        { label: "Direction / R√©gion", value: p.identity?.region }
      ]
    });

    // 2. Lancement des √âtudes
    const studyStart = p.planning?.etudeStart || null;
    const isStudyApprouved = p.etudeAutorisation?.statutEtude === "Approuv√©e";
    const isStudyInProgress = p.etudeAutorisation?.statutEtude === "En cours";
    milestones.push({
      key: "etudes",
      title: "Lancement & Approbation des √âtudes",
      date: studyStart,
      status: isStudyApprouved ? "completed" : (isStudyInProgress || studyStart ? "current" : "pending"),
      color: "bg-amber-500",
      description: "√âlaboration des plans d'ex√©cution et √©tude d'impact environnemental par le BET d√©sign√©.",
      details: [
        { label: "BET Ex√©cution", value: p.ficheSuivi?.etudeBetCabinet },
        { label: "Statut √âtude", value: p.etudeAutorisation?.statutEtude },
        { label: "D√©p√¥t d'√©tude d'Impact", value: p.ficheSuivi?.impactDepotEtude }
      ]
    });

    // 3. Permis de Construire (PC)
    const hasPC = p.etudeAutorisation?.statutPermisConstruire === "Re√ßu";
    const isPCInProgress = p.etudeAutorisation?.statutPermisConstruire === "D√©pos√© - En cours";
    milestones.push({
      key: "permis",
      title: "Dossier Permis de Construire (PC)",
      date: p.etudeAutorisation?.datePermisConstruire || p.ficheSuivi?.depotPcDate || null,
      status: hasPC ? "completed" : (isPCInProgress ? "current" : "pending"),
      color: "bg-indigo-500",
      description: "D√©p√¥t du dossier administratif de permis de construire au niveau des APC comp√©tentes.",
      details: [
        { label: "Statut Permis", value: p.etudeAutorisation?.statutPermisConstruire },
        { label: "Date D√©p√¥t aux APC", value: p.ficheSuivi?.depotPcDate },
        { label: "Date de R√©ception", value: p.etudeAutorisation?.datePermisConstruire }
      ]
    });

    // 4. Expertise Fonci√®re (GEF)
    const gefDesignated = p.etudeAutorisation?.expertiseFonciere?.gefDesignated || !!p.ficheSuivi?.gefCabinet;
    milestones.push({
      key: "expertise",
      title: "D√©signation de l'Expert Foncier (GEF)",
      date: p.ficheSuivi?.demandeGefDate || null,
      status: gefDesignated ? "completed" : "pending",
      color: "bg-emerald-500",
      description: "D√©signation officielle du cabinet d'expertise fonci√®re pour l'identification parcellaire et l'√©tat des lieux.",
      details: [
        { label: "Cabinet GEF d√©sign√©", value: p.etudeAutorisation?.expertiseFonciere?.gefIdentity || p.ficheSuivi?.gefCabinet },
        { label: "Date de Demande GEF", value: p.ficheSuivi?.demandeGefDate },
        { label: "Nature du Terrain", value: p.ficheSuivi?.natureTerrain }
      ]
    });

    // 5. Arr√™t√© de Servitude (AS)
    const asStatus = p.etudeAutorisation?.statutArreteServitude || "Non lanc√©";
    const isASSigned = asStatus === "Sign√© & Publi√©" || !!p.ficheSuivi?.servitudeArreteDate;
    const isASInProgress = asStatus === "En cours de signature" || !!p.ficheSuivi?.depotAsDate;
    milestones.push({
      key: "servitude",
      title: "Arr√™t√© de Servitude (AS) par la Wilaya",
      date: p.ficheSuivi?.servitudeArreteDate || p.ficheSuivi?.depotAsDate || null,
      status: isASSigned ? "completed" : (isASInProgress ? "current" : "pending"),
      color: "bg-orange-500",
      description: "Validation et signature de l'Arr√™t√© de Servitude par les services de la Wilaya pour occupation r√©glementaire.",
      details: [
        { label: "Statut de l'Arr√™t√©", value: p.ficheSuivi?.servitudeArreteStatus || asStatus },
        { label: "R√©f√©rence Arr√™t√©", value: p.etudeAutorisation?.arreteServitudeRef || p.ficheSuivi?.servitudeArreteRef },
        { label: "Date de Signature", value: p.ficheSuivi?.servitudeArreteDate }
      ]
    });

    // 6. Indemnisation des Cultures & Lib√©ration
    const isPaid = p.ficheSuivi?.servitudeQuittancesPv === "Oui";
    milestones.push({
      key: "indemnisation",
      title: "D√©p√¥t du Ch√®que d'Indemnisation",
      date: p.ficheSuivi?.servitudeQuittancesDate || null,
      status: isPaid ? "completed" : "pending",
      color: "bg-rose-500",
      description: "V√©rification des bar√®mes d'indemnisation des cultures, d√©p√¥t des ch√®ques et √©tablissement des PV de quittances.",
      details: [
        { label: "Quittances pay√©es", value: p.ficheSuivi?.servitudeQuittancesPv === "Oui" ? "Oui (Lib√©r√©)" : "Non (En attente)" },
        { label: "Date de R√®glement", value: p.ficheSuivi?.servitudeQuittancesDate },
        { label: "D√©p√¥t Ch√®que", value: p.ficheSuivi?.servitudeQuittancesPv === "Oui" ? "Effectu√©" : "En cours/Non d√©pos√©" }
      ]
    });

    // 7. Travaux par entreprise / lot s'il y a
    const hasLots = p.lots && p.lots.length > 0;
    const isTravauxPhase = p.identity?.phase === "Travaux" || p.identity?.phase === "Mise en Gaz" || p.identity?.phase === "Cl√¥tur√©";
    const worksDate = p.planning?.travauxStart || null;
    
    const worksDetails: { label: string; value: any }[] = [];
    if (hasLots) {
      p.lots.forEach((lot: any, index: number) => {
        const gcCompany = lot.contrats?.etbGC?.nom || "Non d√©sign√©";
        const gcAv = lot.avancementGC !== undefined ? `${lot.avancementGC}%` : "0%";
        const mecaCompany = lot.contrats?.etbMeca?.nom || "Non d√©sign√©";
        const mecaAv = lot.avancementMeca !== undefined ? `${lot.avancementMeca}%` : "0%";
        worksDetails.push({ label: `Lot ${lot.name || index + 1} (G√©nie Civil)`, value: `${gcCompany} (Av. ${gcAv})` });
        worksDetails.push({ label: `Lot ${lot.name || index + 1} (G√©nie M√©c.)`, value: `${mecaCompany} (Av. ${mecaAv})` });
      });
    } else {
      const gcCompany = p.contrats?.etbGC?.nom || "Non d√©sign√©";
      const gcAv = p.travauxPlanification?.avancementGC !== undefined ? `${p.travauxPlanification.avancementGC}%` : "0%";
      const mecaCompany = p.contrats?.etbMeca?.nom || "Non d√©sign√©";
      const mecaAv = p.travauxPlanification?.avancementMeca !== undefined ? `${p.travauxPlanification.avancementMeca}%` : "0%";
      worksDetails.push({ label: "Entreprise G√©nie Civil", value: `${gcCompany} (Av. ${gcAv})` });
      worksDetails.push({ label: "Entreprise G√©nie M√©canique", value: `${mecaCompany} (Av. ${mecaAv})` });
    }
    // Add global progress as 3rd detail
    worksDetails.push({ label: "Avancement Physique Global", value: `${p.travauxPlanification?.avancementPhysique || 0}%` });

    milestones.push({
      key: "travaux_lots",
      title: "Travaux par Lot & Entreprise",
      date: worksDate,
      status: isTravauxPhase ? "completed" : (p.identity?.phase === "√âtude" ? "pending" : "current"),
      color: "bg-blue-600",
      description: "Suivi physique de la pose et montage des √©quipements par lot et par entreprise (G√©nie Civil, G√©nie M√©canique).",
      details: worksDetails
    });

    // 8. Contraintes & Actions
    const hasContraintes = !!p.identity?.contraintes && p.identity.contraintes !== "Aucune" && p.identity.contraintes !== "N√©ant";
    milestones.push({
      key: "contraintes_actions",
      title: "Contraintes R√©seau & Actions Correctives",
      date: null,
      status: hasContraintes ? "current" : "completed",
      color: "bg-rose-600",
      description: "Visualisation des obstacles bloquant le chantier (oppositions, travers√©es complexes) et des actions correctives engag√©es.",
      details: [
        { label: "Contraintes du projet", value: p.identity?.contraintes || "Aucune contrainte majeure signal√©e" },
        { label: "Actions engag√©es", value: p.identity?.contraintesAction || "Aucune action sp√©cifique requise" }
      ]
    });

    return milestones;
  };

  // Determine active project for Bordereau des prix (supports both standalone module and project details tab)
  const activeBordereauProject = activeModule === "bordereau"
    ? (projects.find(p => p.id === bordereauSelectedProjectId) || projects[0])
    : selectedProject;

  // Dynamic characteristics and item arrays for BPU des Prix Generator
  const diamNum = activeBordereauProject ? parseFloat(activeBordereauProject.identity.caracteristiques?.diametre?.replace(/[^0-9.]/g, '')) || 12 : 12;
  const longNum = activeBordereauProject ? parseFloat(activeBordereauProject.identity.caracteristiques?.longueur?.replace(/[^0-9.]/g, '')) || 15 : 15;

  // 1. √âtudes items
  const etudeItems = activeBordereauProject ? [
    {
      id: "impact",
      code: "1.1",
      designation: "√âtude d'impact sur l'environnement (EIE) et notice d'impact hydraulique r√©glementaire",
      unit: "FF",
      qty: 1,
      price: bePrices.impact ?? 1500000,
      formula: "Forfait global r√©glementaire pour √©tude environnementale"
    },
    {
      id: "topo",
      code: "1.2",
      designation: "Lev√© topographique de pr√©cision, d√©limitation fine du trac√© et piquetage de l'axe de l'ouvrage",
      unit: "km",
