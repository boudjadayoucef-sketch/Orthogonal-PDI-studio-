                              }`}>
                                {m.date && m.date !== "Non renseign√©e" && m.date !== "Non obtenue" && m.date !== "Non sign√©e" && m.date !== "Non pay√©es" ? `Le ${formatDateFrench(m.date)}` : "En attente"}
                              </span>
