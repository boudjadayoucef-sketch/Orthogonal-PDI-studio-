            </p>
            <div className="mt-3.5 space-y-2 text-[11px] font-medium text-slate-700">
              {(() => {
                const pendingPc = projects.filter(p => p.etudeAutorisation?.statutPermisConstruire !== "Re√ßu" && !p.etudeAutorisation?.datePermisConstruire);
                const pendingAs = projects.filter(p => p.etudeAutorisation?.statutArreteServitude !== "Sign√© & Publi√©" && !p.etudeAutorisation?.arreteServitudeRef);
                
                return (
                  <>
                    {pendingPc.map((p, idx) => (
                      <div key={`rec-pc-${idx}`} className="p-2.5 bg-white rounded-xl border border-indigo-100 flex items-start gap-2 shadow-xs">
                        <span className="text-indigo-600 font-black">üéØ Action PC #{idx + 1} :</span>
                        <p className="flex-1 leading-tight text-slate-800">
                          Relancer d'urgence le d√©p√¥t du dossier de Permis de Construire pour <strong>{p.name}</strong> avec le cabinet <strong>{p.ficheSuivi?.etudeBetCabinet || "non d√©sign√©"}</strong>. Date de d√©p√¥t initiale : {p.ficheSuivi?.depotPcDate ? formatDateFrench(p.ficheSuivi.depotPcDate) : "non d√©pos√©"}.
                        </p>
                      </div>
                    ))}
                    {pendingAs.map((p, idx) => (
                      <div key={`rec-as-${idx}`} className="p-2.5 bg-white rounded-xl border border-indigo-100 flex items-start gap-2 shadow-xs">
                        <span className="text-orange-600 font-black">‚ö° Action AS #{idx + 1} :</span>
                        <p className="flex-1 leading-tight text-slate-800">
                          Relancer d'urgence l'obtention de l'Arr√™t√© de Servitude d'octroi du droit de servitude pour <strong>{p.name}</strong> aupr√®s de la Wilaya. Suivi par le bureau d'√©tudes (BET) : <strong>{p.ficheSuivi?.etudeBetCabinet || "non d√©sign√©"}</strong>. Demande d'AS d√©pos√©e le {p.ficheSuivi?.depotAsDate ? formatDateFrench(p.ficheSuivi.depotAsDate) : "en attente"}.
                        </p>
                      </div>
                    ))}
                    {pendingPc.length === 0 && pendingAs.length === 0 && (
                      <p className="text-green-700 font-bold italic">‚úì F√©licitations ! Tous les dossiers r√©glementaires (PC et AS) sont valid√©s pour l'int√©gralit√© du programme.</p>
                    )}
