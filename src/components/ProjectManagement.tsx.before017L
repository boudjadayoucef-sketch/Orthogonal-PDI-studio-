                            statusText = p.etudeAutorisation?.statutEtude || (p.ficheSuivi?.etudeBetStatut === "Oui" ? "Approuv√©e" : "En cours");
                            subText = p.ficheSuivi?.etudeBetCabinet ? `Cabinet: ${p.ficheSuivi.etudeBetCabinet}` : "Non d√©marr√©e";
                            bName = p.ficheSuivi?.etudeBetCabinet || "Non d√©sign√©";
