      price: bePrices.topo ?? 45000,
      formula: `${longNum} km lin√©aires de conduite √† arpenter`
    },
    {
      id: "geo",
      code: "1.3",
      designation: "√âtude g√©otechnique de la plate-forme (Points de sondages, r√©sistivit√© de sol et essais de laboratoire)",
      unit: "U",
      qty: Math.max(3, Math.ceil(longNum / 2)),
      price: bePrices.geo ?? 120000,
      formula: `1 point de sondage tous les 2 km (min. 3) pour ${longNum} km`
    },
    {
      id: "ing",
      code: "1.4",
      designation: "Calculs d'ing√©nierie d√©taill√©e, dimensionnement hydraulique, m√©canique et plans d'ex√©cution",
      unit: "FF",
      qty: 1,
