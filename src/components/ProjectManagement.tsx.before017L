                        </tr>
                      </thead>
                      <tbody>
                        {projects.map((p) => {
                          let isGreen = false;
                          let statusText = "";
                          let subText = "";
                          let bName = "";
                          let leveeText = "Aucune";
                          let actionText = "Aucune action requise";

                          if (selectedIndicatorTab === "permis") {
                            isGreen = !!(p.etudeAutorisation?.statutPermisConstruire === "Re√ßu" || p.etudeAutorisation?.datePermisConstruire);
                            statusText = p.etudeAutorisation?.statutPermisConstruire || (p.etudeAutorisation?.datePermisConstruire ? "Obtenu" : "Non d√©pos√©");
                            subText = p.etudeAutorisation?.datePermisConstruire ? "Obtenu le " + formatDateFrench(p.etudeAutorisation.datePermisConstruire) : p.ficheSuivi?.depotPcDate ? "D√©pos√© le " + formatDateFrench(p.ficheSuivi.depotPcDate) : "Non d√©marr√©";
                            bName = p.ficheSuivi?.etudeBetCabinet || "Cabinet non renseign√©";
                            leveeText = p.ficheSuivi?.etudeLeveeReserveStatus || (p.ficheSuivi?.etudeLeveeReserveDate ? "Lev√©e" : "Aucune");
                            actionText = p.ficheSuivi?.etudeActionStatus || "N/A";
                          } else if (selectedIndicatorTab === "servitude") {
                            isGreen = p.etudeAutorisation?.statutArreteServitude === "Sign√© & Publi√©" || !!p.etudeAutorisation?.arreteServitudeRef;
                            statusText = p.etudeAutorisation?.statutArreteServitude || "Non lanc√©";
                            subText = p.etudeAutorisation?.arreteServitudeRef ? "Arr√™t√© n¬∞ " + p.etudeAutorisation.arreteServitudeRef : (p.ficheSuivi?.depotAsDate ? "D√©pos√© le " + formatDateFrench(p.ficheSuivi.depotAsDate) : "Non d√©pos√©");
                            bName = p.ficheSuivi?.etudeBetCabinet || "Cabinet non renseign√©";
                            leveeText = p.ficheSuivi?.etudeLeveeReserveStatus || (p.ficheSuivi?.etudeLeveeReserveDate ? "Lev√©e" : "Aucune");
                            actionText = p.ficheSuivi?.etudeActionStatus || "N/A";
                          } else if (selectedIndicatorTab === "etude") {
