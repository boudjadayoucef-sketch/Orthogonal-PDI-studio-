            <p className="text-[11px] text-slate-400">Progression individuelle des gazoducs par rapport √† la cible de livraison (100%).</p>

            <div className="space-y-3.5 max-h-[140px] overflow-y-auto pr-1">
              {projects.map(p => (
                <div key={p.id} className="space-y-1.5 text-xs">
