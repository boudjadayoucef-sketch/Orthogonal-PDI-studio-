            <td style="border: 1px solid #e2e8f0; padding: 5px; font-size: 8.5pt; font-weight: bold; color: ${p.travauxPlanification?.essaisReglementaires?.epreuveEtancheite === "R√©ussie" ? "#047857" : "#d97706"}">
