                  </div>
                  <span className={`text-[9px] font-extrabold px-2 py-0.5 rounded-full ${pct >= 85 ? "bg-green-100 text-green-800" : pct >= 50 ? "bg-amber-100 text-amber-800" : "bg-red-100 text-red-800"}`}>
